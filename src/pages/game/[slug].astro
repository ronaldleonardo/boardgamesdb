---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { games, categories } from '../../lib/data.mjs';

export async function getStaticPaths() {
  return games.map(g => ({
    params: { slug: g.slug },
    props: { game: g }
  }));
}

const { game } = Astro.props;
const cat = categories[game.category];
const amazon = `https://www.amazon.com/s?k=${encodeURIComponent(game.name)}+board+game&tag=tabletopharve-20`;
const sameCat = games.filter(g => g.category === game.category && g.slug !== game.slug).slice(0, 3);
---

<BaseLayout title={`${game.name} Board Game Review: ${game.players} Player ${cat.name}`} description={`${game.name} board game review. ${game.players} players, ${game.playtime} min, age ${game.age}+. ${game.desc.slice(0, 100)}`}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    name: game.name,
    description: game.desc,
    image: `https://tabletoppicks.com${game.image}`,
    offers: {
      "@type": "Offer",
      price: game.price,
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: amazon
    },
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: game.rating,
      bestRating: 10,
      ratingCount: 100
    }
  })} />
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href={`/games/${game.category}`}>{cat.name}</a> / {game.name}
    </div>

    <div class="game-header">
      <div class="game-header-img">
        <a href="#lightbox" class="lightbox-trigger">
          <img src={game.image} alt={game.name} />
        </a>
      </div>
      <div class="game-header-info">
        <h1>{game.name}</h1>
        <div class="game-tags">
          <span class="tag">{cat.name}</span>
          <span class="tag">{game.tag?.replace('-', ' ')}</span>
        </div>
        <div class="game-specs">
          <div class="spec">
            <span class="spec-label">Players</span>
            <span class="spec-value">{game.players}</span>
          </div>
          <div class="spec">
            <span class="spec-label">Playtime</span>
            <span class="spec-value">{game.playtime} min</span>
          </div>
          <div class="spec">
            <span class="spec-label">Age</span>
            <span class="spec-value">{game.age}+</span>
          </div>
          <div class="spec">
            <span class="spec-label">Rating</span>
            <span class="spec-value">★ {game.rating}</span>
          </div>
          <div class="spec">
            <span class="spec-label">Complexity</span>
            <span class="spec-value">{game.complexity}/5</span>
          </div>
          <div class="spec">
            <span class="spec-label">Price</span>
            <span class="spec-value price">${game.price}</span>
          </div>
        </div>
        <a href={amazon} class="btn-primary">Check Price on Amazon</a>
      </div>
    </div>

    <div class="game-content">
      <div class="game-section">
        <h2>About This Game</h2>
        <p>{game.desc}</p>
        <p class="why-pick-box"><strong>Why we picked it:</strong> {game.why}</p>
      </div>

      <div class="game-section">
        <h2>How to Play</h2>
        <p>{game.name} plays with {game.players} players and takes about {game.playtime} minutes. It is recommended for ages {game.age}+ with a complexity rating of {game.complexity} out of 5.</p>
        <p>The goal depends on the game type. {cat.name} games focus on {cat.desc.toLowerCase()}. Each round pushes players to make decisions, adapt to the board state, and outplay their opponents.</p>
        <p>Setup is straightforward. The rulebook is designed to get you playing fast, not reading for 30 minutes. Most groups understand the flow within the first round.</p>
      </div>

      <div class="game-section">
        <h2>What Makes It Fun</h2>
        <p>The best part of {game.name} is how it creates moments. Every session has a story. A comeback win. A close call. A move that made everyone at the table react.</p>
        <p>It balances luck and skill. New players can win. Experienced players can consistently do well. That balance keeps the game coming back to the table.</p>
      </div>

      <div class="game-section">
        <h2>Who Is It For</h2>
        <p>This game works best for groups that enjoy {cat.name.toLowerCase()}. If you like thinking on your feet, reading the table, and games that change every time, {game.name} is a solid pick.</p>
        <p>It works for both casual players and experienced gamers. The rules are light enough for beginners but the decisions are deep enough for veterans.</p>
      </div>

      <div class="game-section game-cta-section">
        <h2>Ready to Buy?</h2>
        <p>If this sounds like your kind of game, grab a copy on Amazon. Prices fluctuate so check the current price before buying.</p>
        <a href={amazon} class="btn-primary">Check Price on Amazon</a>
      </div>
    </div>

    {sameCat.length > 0 && (
      <div class="game-section">
        <h2>More {cat.name}</h2>
        <div class="game-row-list">
          {sameCat.map(g => (
            <a href={`/game/${g.slug}`} class="game-row-link">
              <img src={g.image} alt={g.name} class="game-thumb" />
              <div class="game-row-info">
                <strong>{g.name}</strong>
                <span class="game-meta-sm">★ {g.rating}  |  {g.players}p  |  ${g.price}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Lightbox Modal -->
  <div id="lightbox" class="lightbox">
    <a href="#" class="lightbox-close">×</a>
    <div class="lightbox-content">
      <img src={game.image} alt={game.name} />
    </div>
  </div>
</BaseLayout>

<style>
.breadcrumb { padding: 20px 0 16px; font-size: 0.82rem; color: var(--muted); }
.breadcrumb a { color: var(--muted); text-decoration: none; }
.breadcrumb a:hover { color: var(--accent); }

.game-header { display: flex; gap: 32px; margin-bottom: 40px; align-items: start; }
.game-header-img { flex-shrink: 0; width: 280px; }
.game-header-img img { width: 100%; border-radius: 12px; border: 3px solid var(--border); box-shadow: 0 4px 0 var(--border); }
.game-header-info { flex: 1; }
.game-header-info h1 { margin: 0 0 8px; font-size: 1.8rem; }
.game-tags { display: flex; gap: 6px; margin-bottom: 16px; }
.tag { background: var(--tag-bg); padding: 4px 12px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; }
.game-specs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 20px; }
.spec { background: var(--surface); border: 2px solid var(--border); border-radius: 10px; padding: 10px; text-align: center; }
.spec-label { display: block; font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
.spec-value { display: block; font-size: 1rem; font-weight: 700; margin-top: 2px; }
.spec-value.price { color: var(--accent); }

.game-content { max-width: 700px; }
.game-section { margin-bottom: 32px; }
.game-section h2 { font-size: 1.2rem; margin-bottom: 8px; }
.game-section p { font-size: 0.95rem; line-height: 1.6; color: #444; }
.why-pick-box { background: #fff8f0; padding: 12px 16px; border-radius: 10px; border-left: 4px solid var(--accent); }
.game-cta-section { background: var(--surface); border: 3px solid var(--border); border-radius: 14px; padding: 24px; text-align: center; box-shadow: 0 4px 0 var(--border); }
.game-cta-section h2 { margin-top: 0; }

.game-row-list { display: flex; flex-direction: column; gap: 8px; }
.game-row-link { display: flex; align-items: center; gap: 12px; background: var(--surface); border: 2px solid var(--border); border-radius: 10px; padding: 10px 14px; text-decoration: none; color: var(--text); transition: all 0.12s; }
.game-row-link:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 3px 0 var(--border); }
.game-thumb { width: 50px; height: 50px; object-fit: contain; border-radius: 6px; background: #f8f9fa; }
.game-row-info { flex: 1; }
.game-row-info strong { display: block; font-size: 0.9rem; }
.game-meta-sm { font-size: 0.78rem; color: var(--muted); }

@media (max-width: 640px) {
  .game-header { flex-direction: column; }
  .game-header-img { width: 160px; }
  .game-specs { grid-template-columns: repeat(3, 1fr); }
}

/* Lightbox */
.lightbox { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 999; justify-content: center; align-items: center; }
.lightbox:target { display: flex; }
.lightbox-close { position: absolute; top: 16px; right: 24px; font-size: 2.5rem; color: white; text-decoration: none; z-index: 1000; font-weight: 300; line-height: 1; }
.lightbox-close:hover { color: var(--accent); }
.lightbox-content { max-width: 85vw; max-height: 85vh; }
.lightbox-content img { max-width: 100%; max-height: 85vh; object-fit: contain; border-radius: 8px; box-shadow: 0 8px 40px rgba(0,0,0,0.5); }
.lightbox-trigger { cursor: pointer; }
.lightbox-trigger img { transition: transform 0.12s; }
.lightbox-trigger:hover img { transform: scale(1.02); }
</style>